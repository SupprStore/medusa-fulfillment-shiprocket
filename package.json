{
  "name": "medusa-fulfillment-shiprocket",
  "version": "0.0.3",
  "description": "Shiprocket fulfillment plugin for MedusaJS",
  "license": "MIT",
  "keywords": [
    "medusa",
    "shiprocket",
    "medusa-fulfillment",
    "medusa-plugin",
    "ecommerce",
    "headless"
  ],
  "files": [
    "**/*.js",
    "**/*.d.ts"
  ],
  "exports": {
    "./package.json": "./package.json",
    "./providers/*": "./providers/*/index.js",
    "./*": "./*.js"
  },
  "scripts": {
    "prepare": "cross-env NODE_ENV=production yarn run build",
    "build": "babel src --out-dir . --ignore **/__tests__ --extensions \".ts,.js\"",
    "watch": "babel -w src --out-dir . --ignore **/__tests__ --extensions \".ts,.js\""
  },
  "dependencies": {
    "@medusajs/utils": "^2.13.4",
    "axios": "^1.3.4",
    "axios-rate-limit": "^1.8.0",
    "axios-retry": "^4.5.0"
  },
  "peerDependencies": {
    "@medusajs/framework": "^2.0.0"
  },
  "devDependencies": {
    "@babel/cli": "^7.14.3",
    "@babel/core": "^7.14.3",
    "@medusajs/framework": "^2.0.0",
    "babel-preset-medusa-package": "^1.1.19",
    "cross-env": "^5.2.1",
    "eslint": "^6.8.0",
    "typescript": "^5.9.3"
  }
}
